{
  "name": "sharepairs-backend",
  "version": "1.0.0",
  "description": "Share Pairs Lambda backend functions",
  "type": "module",
  "scripts": {
    "dev": "SIMPATICO_ENV=local MEMORY_DB=true node dev.mjs",
    "dev:memory": "SIMPATICO_ENV=local MEMORY_DB=true node dev.mjs",
    "dev:dynamo": "SIMPATICO_ENV=local MEMORY_DB=false node dev.mjs",
    "seed": "AWS_REGION=us-east-1 node scripts/seed.js",
    "test": "MEMORY_DB=true STUB_AUTH=true STUB_AUTH_SECRET=test-secret node --test scripts/prompt-analytics.test.js scripts/distress-safety.test.js scripts/auth-access.test.js scripts/assessment-baseline.test.js scripts/assessment-redcap.test.js scripts/assessment-followup.test.js scripts/cssrs-screening.test.js scripts/message-moderation.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.490.0",
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-ses": "^3.490.0",
    "@aws-sdk/client-sqs": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jose": "^5.2.0",
    "ws": "^8.18.0"
  }
}

