# Copy to .env or set in Lambda environment
STAGE=dev
AWS_REGION=us-east-1

# DynamoDB table names (default: sharepairs-{STAGE}-users, etc.)
USERS_TABLE=sharepairs-dev-users
CONVERSATIONS_TABLE=sharepairs-dev-conversations
MESSAGES_TABLE=sharepairs-dev-messages
ASSESSMENTS_TABLE=sharepairs-dev-assessments

# REDCap export is off until the study team confirms project mapping.
# Credentials alone will not send data.
# REDCAP_API_URL=
# REDCAP_API_TOKEN=
# REDCAP_MAPPING_CONFIRMED=false

# Stub auth for local/dev (set to true to use email/password from users table)
STUB_AUTH=true
STUB_AUTH_SECRET=your-random-secret-change-in-prod

# Study notifications are sent from this address. Required on the study API.
SES_FROM_EMAIL=eolstudysupport@med.cornell.edu

# CORS (use your frontend origin in prod)
CORS_ORIGIN=*

# Local API: MEMORY_DB=false (default via npm run dev) uses real DynamoDB.
# MEMORY_DB=true keeps an ephemeral in-memory store (no AWS).
# MEMORY_DB=false

# Optional: DynamoDB Local
# DYNAMODB_ENDPOINT=http://localhost:8000

# Optional: Lambda local
# IS_LOCAL=true
# AWS_SAM_LOCAL=true
